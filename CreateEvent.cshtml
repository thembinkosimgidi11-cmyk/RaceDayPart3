@model EventVM
<h1>Create event</h1>@if(ViewBag.Error!=null){<p class="error">@ViewBag.Error</p>}<form method="post"><label>Event name</label><input asp-for="EventName" required/><label>Description</label><textarea asp-for="Description"></textarea><label>Date</label><input asp-for="EventDate" type="date" required/><label>Start time</label><input asp-for="StartTime" type="time" required/><label>Location</label><input asp-for="Location" required/><label>Status</label><select asp-for="Status"><option>Upcoming</option><option>Completed</option><option>Cancelled</option></select><button>Create event</button></form>
